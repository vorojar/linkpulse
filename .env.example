# Copy to .env and fill in real values before first run.
# cp .env.example .env

# Admin password for the dashboard (required, no default for production)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Salt for hashing visitor IPs (privacy: raw IPs are never stored).
# Generate one: openssl rand -hex 16
IP_SALT=change-me-random-hex

# Shared secret protecting POST /api/cron/aggregate (daily stats rollup)
CRON_SECRET=change-me-random-hex

# Postgres password used by docker-compose
POSTGRES_PASSWORD=change-me-db-password

# Port the web service listens on
PORT=8080
